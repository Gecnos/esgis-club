# Copier ce fichier en .env.local (non versionné). Voir docs/supabase.md.
# Laisser les deux premières variables vides = mode démo (données de démonstration).

# Supabase : Project Settings > API (clé « anon » publique uniquement, jamais la clé service_role)
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Domaine public du bucket R2 des images, sans slash final : URL r2.dev (essais) ou domaine personnalisé (prod).
# Pas l'adresse « S3 API » (…r2.cloudflarestorage.com) : elle est privée. Voir docs/supabase.md §4.
VITE_R2_PUBLIC_URL=

# Adresse publique du site, sans slash final (ex. https://clubs.esgis.bj). Sert à l'URL canonique, au sitemap.xml et au partage.
VITE_SITE_URL=
