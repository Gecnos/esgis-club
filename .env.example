# Copier ce fichier en .env.local (non versionné). Voir docs/supabase.md.
# Laisser les deux premières variables vides = mode démo (données de démonstration).

# Supabase : Project Settings > API (clé « anon » publique uniquement, jamais la clé service_role)
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Domaine public du bucket R2 des images, sans slash final (ex. https://images.esgis-clubs.bj)
VITE_R2_PUBLIC_URL=
